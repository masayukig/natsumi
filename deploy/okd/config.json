{
  "pi": {
    "agentDirectory": "/var/lib/natsumi-pi/agent",
    "sessionDirectory": "/var/lib/natsumi-pi/sessions",
    "authPath": "/var/lib/natsumi-pi/agent/auth.json",
    "routes": {
      "codex": {
        "model": { "provider": "openai-codex", "id": "gpt-5.5" },
        "compactionThreshold": 150000
      }
    },
    "defaultRoute": "codex",
    "voiceEnabled": false
  },
  "publicOrigin": "https://natsumi.apps.lab.igawa.io",
  "listen": {
    "host": "::",
    "port": 8080,
    "tls": false,
    "behindProxy": true
  },
  "github": {
    "clientId": "Ov23liK6NOzWHcsmDrjJ",
    "clientSecretFile": "/run/secrets/natsumi-github/client-secret",
    "callbackUrl": "https://natsumi.apps.lab.igawa.io/auth/github/callback",
    "allowedUserId": 116281
  },
  "slack": {
    "workspaces": {
      "openstackwarrior": {
        "botTokenFile": "/run/secrets/natsumi-slack/bot-token",
        "appTokenFile": "/run/secrets/natsumi-slack/app-token"
      }
    },
    "owner": { "workspace": "openstackwarrior", "userId": "<OWNER_SLACK_USER_ID>", "channel": "<NATSUMI_CHANNEL_ID>" }
  },
  "loop": {
    "timeZone": "Asia/Tokyo",
    "nightlyRotationAt": "04:00",
    "compactionThreshold": 60000,
    "compactionKeepRecent": 20000,
    "awakeHours": { "start": "08:00", "end": "23:00" },
    "pingIntervalMinutes": 30,
    "selfCheck": { "minDelayMinutes": 5, "maxDelayDays": 7, "maxPending": 5, "maxPerDay": 20 },
    "expressionResetMinutes": 3,
    "reviewModelCalls": 40,
    "reviewTimeoutMinutes": 30,
    "eventModelCalls": 8,
    "eventTimeoutMinutes": 10,
    "workspaceSocket": "/run/natsumi-workspace/runner/runner.sock",
    "memoryFileMaxChars": 32000,
    "alwaysMemoryMaxChars": 2000,
    "turnFold": "off"
  },
  "curator": {
    "enabled": true,
    "modelCalls": 60,
    "timeoutMinutes": 30,
    "rotateFiles": 2
  }
}
