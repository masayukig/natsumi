{
  "pi": {
    "agentDirectory": "/var/lib/natsumi-pi/agent",
    "sessionDirectory": "/var/lib/natsumi-pi/sessions",
    "authPath": "/var/lib/natsumi-pi/agent/auth.json",
    "routes": {
      "local": {
        "model": { "provider": "natsumi-compatible", "id": "example-model" },
        "compatible": { "baseUrl": "https://llm.example.net/v1", "apiKeyFile": "/run/secrets/natsumi_pi_api_key", "contextWindow": 131072 }
      },
      "plus": {
        "model": { "provider": "openai", "id": "gpt-6.1-sol" },
        "compactionThreshold": 150000
      }
    },
    "defaultRoute": "local",
    "voiceEnabled": false
  },
  "publicOrigin": "https://natsumi.example.net:8443",
  "listen": {
    "host": "::",
    "port": 8443,
    "tls": {
      "certFile": "/run/secrets/natsumi_tls_cert",
      "keyFile": "/run/secrets/natsumi_tls_key"
    }
  },
  "github": {
    "clientId": "Ov23liExampleClientId",
    "clientSecretFile": "/run/secrets/natsumi_github_client_secret",
    "callbackUrl": "https://natsumi.example.net:8443/auth/github/callback",
    "allowedUserId": 12345678
  },
  "loop": {
    "timeZone": "Asia/Tokyo",
    "nightlyRotationAt": "02:00",
    "compactionThreshold": 60000,
    "compactionKeepRecent": 20000,
    "awakeHours": { "start": "08:00", "end": "23:00" },
    "pingIntervalMinutes": 30,
    "expressionResetMinutes": 3,
    "reviewModelCalls": 40,
    "reviewTimeoutMinutes": 30,
    "eventModelCalls": 8,
    "eventTimeoutMinutes": 10,
    "shutdownDrainSeconds": 600,
    "workspaceSocket": "/run/natsumi-workspace/runner.sock",
    "memoryFileMaxChars": 32000,
    "alwaysMemoryMaxChars": 2000,
    "goalFileMaxChars": 6000,
    "todayPlanMaxChars": 3000,
    "turnFold": "off",
    "codemode": { "enabled": false, "workspaceTools": "direct", "nestedCalls": 40 }
  },
  "curator": {
    "enabled": true,
    "modelCalls": 100,
    "timeoutMinutes": 60,
    "stopStartingAt": "05:30",
    "pillStopStartingAfterMinutes": 90,
    "rotateFiles": 2,
    "rewriteAllMaxChars": 100000,
    "conversationMaxChars": 30000,
    "codemode": { "enabled": false, "workspaceTools": "direct", "nestedCalls": 120 }
  },
  "skills": { "enabled": false },
  "postbox": { "enabled": true, "minIntervalMinutes": 15 },
  "tools": [],
  "avatar": { "id": "natsumi" }
}
