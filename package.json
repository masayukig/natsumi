{
  "name": "natsumi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web",
    "test": "node --test test/*.test.ts",
    "test:browser": "npm run build:web && node --test test/e2e/*.test.ts",
    "build": "tsc && npm run build:web",
    "build:web": "node scripts/build-web.ts",
    "start": "node dist/src/server/main.js serve",
    "probe:live": "node src/probe/live.ts",
    "fake-server": "node src/fake-server/main.ts",
    "probe:jev": "node src/probe/jev-eval.ts",
    "probe:fold": "node src/probe/fold-live.ts",
    "probe:fold-replay": "node src/probe/fold-replay.ts",
    "eval": "node src/eval/cli.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.2.0",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@slack/socket-mode": "3.0.1",
    "@slack/web-api": "8.1.1",
    "markdown-it": "15.0.2",
    "preact": "10.29.8",
    "typebox": "1.3.27",
    "ws": "8.21.3",
    "yaml": "2.9.1"
  }
}
